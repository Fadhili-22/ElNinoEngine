# data and models (team-only, EM-DAT licence)
data/*.csv
models/*
app/data/*

# EXCEPTION: the four files that the monthly forecast (GitHub Actions) and the invite-only app need.
# The model and the backtest file are made with flood labels that include EM-DAT data, so these files
# may only be pushed to a PRIVATE repository (see "Deployment" and "Data licence" in README.md).
!models/xgboost.joblib
!models/xgboost_settings.json
!app/data/app_predictions.csv
!app/data/kenya_counties_simple.geojson
# rainfall and soil numbers per county and month for the scenario page (no flood records), made by app/make_scenario_reference.py
!app/data/scenario_reference.csv

# downloads of src/update_forecast.py (public files, but large and always re-downloadable)
data/live/

# local launcher and certificate check (machine specific)
app/run_app.ps1
app/run_app.py
app/check_windows_certs.py

# python and jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# spreadsheets made from the flood records (EM-DAT licence: team only)
*.xlsx
